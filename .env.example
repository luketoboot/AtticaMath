# Daily challenge leaderboard (optional).
#
# With these unset the game runs exactly as it does with them set, except the
# daily board is device-local and says so on screen. Copy to `.env` and fill in
# from the Supabase dashboard (Project Settings -> API) to share the board.
#
# The anon/publishable key is meant to ship to the browser — it is not a secret,
# and row-level security is what actually protects the table. Never put the
# service_role key here: anything VITE_-prefixed is bundled into the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
